# Frontend environment configuration (Create React App)
#
# The HTTP notes repository will prefer REACT_APP_API_BASE if set:
#   REACT_APP_API_BASE="http://localhost:3001/api"
#
# Otherwise it will fall back to REACT_APP_BACKEND_URL + "/api":
#   REACT_APP_BACKEND_URL="http://localhost:3001"

REACT_APP_API_BASE=http://localhost:3001/api
# REACT_APP_BACKEND_URL=http://localhost:3001
